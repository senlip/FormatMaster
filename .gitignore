# =========================================================================== #
# FormatMaster 仓库忽略规则
#
# 原则：**只入库能读懂、能复现的源码**。
#   二进制、第三方代码、构建产物、运行时产物一律不入库；
#   安装包走 GitHub Release 附件，ffmpeg 由使用者自行获取。
# =========================================================================== #

# ---------------- Python ----------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/

# ---------------- 构建产物 ----------------
# 打包中间件与最终产物：体积大、可复现，不入库
dist/
dist_installer/
build/work/
build/_dist_old_*/
build/__pycache__/

# ---------------- 第三方参考实现（他人项目） ----------------
# 开发期用来比对算法与生成校验向量的第三方代码，各自有独立许可证。
# 本项目只作为本地参考，不随本仓库再分发。
build/ref/

# ---------------- 第三方安装器工具 ----------------
# Inno Setup 6 安装程序（约 43 MB），构建机本地准备即可
build/tools/

# ---------------- 外部二进制 ----------------
# ffmpeg / ffprobe 体积约 158 MB，且属第三方 GPL 二进制，
# 请按 README「开发环境」一节自行下载放入 tools/ffmpeg/bin/
tools/ffmpeg/
tools/*.zip

# ---------------- 测试运行产物 ----------------
tests/_work/

# ---------------- 杂项 ----------------
*.log
.DS_Store
Thumbs.db
desktop.ini
